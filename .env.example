# ============================================================================
# Caravan Accounting - Environment Configuration
# ============================================================================

APP_NAME="Caravan Accounting"
APP_ENV="production" # local, staging, production
APP_DEBUG=false
APP_URL="https://accounts.example.com"
APP_TIMEZONE="Asia/Kolkata"

# Database Configuration (MySQL / MariaDB)
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="caravan_accounting"
DB_USERNAME="caravan_user"
DB_PASSWORD="replace_with_strong_password"

# Session & Security
# Session inactivity lifetime in minutes (SRS FR-AUTH-7: 30 minutes)
SESSION_LIFETIME_MINUTES=30
# Cookie security (set to false only in non-HTTPS local dev)
COOKIE_SECURE=true
COOKIE_SAMESITE="Lax"
# Rate limiting: max consecutive login attempts before 15-minute lockout (FR-AUTH-5)
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# File Upload Configuration (FR-BILL-1, FR-BILL-2, FR-BILL-3)
# Path to storage folder relative to API root (outside web root)
STORAGE_PATH="../storage"
# Maximum file upload size in megabytes
MAX_BILL_FILE_SIZE_MB=5
# Allowed MIME types
ALLOWED_BILL_MIMES="image/jpeg,image/png,application/pdf"

# Business & Organization Details (for Reports & Invoices)
COMPANY_NAME="Caravan Accounting"
COMPANY_PHONE=""
COMPANY_EMAIL="accounts@caravan.local"
COMPANY_ADDRESS="Mumbai, India"
COMPANY_CURRENCY="INR"
COMPANY_CURRENCY_SYMBOL="₹"
